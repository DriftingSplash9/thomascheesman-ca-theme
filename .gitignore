.claude/

# Dev helper scripts — image audits, run locally, not part of the theme
db-image-audit.py
build-image-audit.py
test-image-urls.py
remove-dead-images.py
image-audit*.xlsx

# Keepsake PDF generator + its output. The generator runs locally (Playwright
# + Pillow); the finished PDFs are uploaded to WP Media, not committed.
build-keepsake-pdfs.py
keepsake-pdfs/

# Preservation export (RISK-1) — local off-host mirror of the PUBLIC site
# (HTML + media). Generator is stdlib-only; the ~100 MB output is for
# off-host backup + the Internet Archive, never committed.
build-site-archive.py
site-archive/

# Secret-bearing files that should never land in git. Belt-and-
# suspenders: even if one of these gets dropped into the theme folder
# by mistake (e.g. a Google Cloud credentials.json from the Site Kit
# wizard), git won't see it.
credentials*.json
client_secret*.json
service-account*.json
*.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Python bytecode cache
__pycache__/
