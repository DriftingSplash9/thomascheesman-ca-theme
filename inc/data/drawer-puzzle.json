{
  "version": 2,
  "_comment": "Phase 4 — the real Secret Drawer puzzle. Source of truth: Secret-Drawer-Items (NEW2).docx + Secret-Drawer-Playbook.docx (off-repo, on Thomas's Desktop). Background: real photos of Thomas's actual drawer (meme stickers baked in as permanent flavor). Two view states (`junk-*` wide top-down vs `secret-*` close-up of the recessed compartments) × two dust states (clean / dusty) = four surfaces. The wide junk view is the start; chain 8 (padlock) gates the transition to the secret view. Every puzzle item is an engine overlay placed on top. Chains land in commit-sized batches; each chain commit bumps the theme version. The engine's full action-verb surface is documented in the docblock of drawer-engine.js — Phase 4 adds: `video`, `fullscreen`, `passcode`, and `require` (interaction-level flag preconditions). Object coordinates are placeholders until the ?author-mode layout pass; the layout commit lands at the end of Phase 4.",

  "_chains": {
    "0-todo":       "You Got This notebook → click → to-do clue (Find Ring · Tidy drawer · Dust + scribbled notes)",
    "1-start":      "screwdriver + screw → dust appears → duster clears it → reveals duck pin (Top Prize path). Leaving dust = Golden Egg path.",
    "2-hulk":       "Hulk + hammer → armed Hulk → smash silver nugget → Rings (Find Ring ✓). Torch on Rings → 'one PEZ dispenser to rule them all'. Click PEZ → Auction Receipt ($264M Faberge foreshadow).",
    "3-duck":       "Mini Pump + small duck → midway duck → giant duck. Click giant duck → fullscreen browser crush. Pineapple duck is a one-liner easter egg."
  },

  "surfaces": {
    "junk-clean":   3660,
    "junk-dusty":   3661,
    "secret-clean": 3724,
    "secret-dusty": 3725
  },
  "start": "junk-clean",

  "objects": {

    "todo-notebook": {
      "name": "You Got This notebook",
      "media": 3632,
      "x": 50, "y": 28, "w": 18, "rot": -2,
      "state": "shown",
      "hint": "the to-do list"
    },

    "screw": {
      "name": "loose screw",
      "media": 3690,
      "x": 50, "y": 50, "w": 6, "rot": 0,
      "state": "shown",
      "hint": "this looks loose"
    },
    "screwdriver": {
      "name": "multi-bit screwdriver",
      "media": 3609,
      "x": 50, "y": 50, "w": 16, "rot": 0,
      "state": "shown",
      "draggable": true,
      "hint": "for tightening things"
    },
    "green-duster": {
      "name": "green duster",
      "media": 3683,
      "x": 50, "y": 50, "w": 14, "rot": 0,
      "state": "hidden",
      "draggable": true,
      "hint": "green duster"
    },
    "duck-pin": {
      "name": "lemonade duck pin",
      "media": 3654,
      "x": 50, "y": 50, "w": 9, "rot": 0,
      "state": "hidden",
      "hint": "got any grapes?"
    },

    "hulk-no-hammer": {
      "name": "Hulk (unarmed)",
      "media": 3673,
      "x": 50, "y": 50, "w": 12, "rot": 0,
      "state": "shown",
      "draggable": true,
      "hint": "missing something"
    },
    "hulks-hammer": {
      "name": "Hulk's hammer",
      "media": 3670,
      "x": 50, "y": 50, "w": 10, "rot": 0,
      "state": "shown",
      "draggable": true,
      "hint": "rebar handle, concrete head"
    },
    "armed-hulk": {
      "name": "armed Hulk",
      "media": 3657,
      "x": 50, "y": 50, "w": 12, "rot": 0,
      "state": "hidden",
      "draggable": true,
      "hint": "HULK SMASH"
    },
    "silver-nugget": {
      "name": "silver nugget",
      "media": 3659,
      "x": 50, "y": 50, "w": 11, "rot": 0,
      "state": "shown",
      "draggable": true,
      "hint": "heavy"
    },
    "rings": {
      "name": "rings",
      "media": 3636,
      "x": 50, "y": 50, "w": 10, "rot": 0,
      "state": "hidden",
      "draggable": true,
      "hint": "the precious"
    },
    "torch-lighter": {
      "name": "iridescent torch lighter",
      "media": 3658,
      "x": 50, "y": 50, "w": 8, "rot": 0,
      "state": "shown",
      "draggable": true,
      "hint": "burns hotter than it looks"
    },
    "pez": {
      "name": "PEZ dispenser",
      "media": 3641,
      "x": 50, "y": 50, "w": 7, "rot": 0,
      "state": "shown",
      "hint": "PEZ"
    },
    "auction-receipt": {
      "name": "auction receipt",
      "media": 3642,
      "x": 50, "y": 50, "w": 11, "rot": 0,
      "state": "hidden",
      "hint": "$264,000,000"
    },

    "mini-pump": {
      "name": "mini air pump",
      "media": 3680,
      "x": 50, "y": 50, "w": 9, "rot": 0,
      "state": "shown",
      "draggable": true,
      "hint": "for inflating things"
    },
    "duck-small": {
      "name": "rubber duck (small)",
      "media": 3671,
      "x": 50, "y": 50, "w": 7, "rot": 0,
      "state": "shown",
      "draggable": true,
      "hint": "rubber duck"
    },
    "duck-mid": {
      "name": "rubber duck (mid)",
      "media": 3672,
      "x": 50, "y": 50, "w": 11, "rot": 0,
      "state": "hidden",
      "draggable": true,
      "hint": "bigger"
    },
    "duck-giant": {
      "name": "rubber duck head",
      "media": 3677,
      "x": 50, "y": 50, "w": 18, "rot": 0,
      "state": "hidden",
      "hint": "click."
    },
    "duck-pineapple": {
      "name": "pineapple duck",
      "media": 3686,
      "x": 50, "y": 50, "w": 7, "rot": 0,
      "state": "shown",
      "hint": "?"
    }

  },

  "zones": {

    "dust-spot": {
      "x": 80, "y": 22, "w": 18, "h": 16,
      "state": "hidden",
      "hint": "dust"
    }

  },

  "interactions": [

    {
      "id": "todo-list",
      "on": "click", "object": "todo-notebook",
      "do": [
        { "clue": "TO DO\n  · Find Ring\n  · Tidy drawer\n  · Dust\n\n— notes to self —\n  · banana → eat it, or save it?\n  · drink the Ensure\n  · 67676767 ←" }
      ]
    },

    {
      "id": "tighten-screw",
      "on": "combine", "a": "screwdriver", "b": "screw",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "surface": "junk-dusty" },
        { "reveal": ["green-duster", "dust-spot"] },
        { "remove": ["screw", "screwdriver"] },
        { "flag": "screw-tight" }
      ]
    },
    {
      "id": "clear-dust",
      "on": "drop", "object": "green-duster", "zone": "dust-spot",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "surface": "junk-clean" },
        { "remove": ["green-duster"] },
        { "hide": ["dust-spot"] },
        { "reveal": ["duck-pin"] },
        { "flag": "dust-cleared" }
      ]
    },
    {
      "id": "duck-pin-clue",
      "on": "click", "object": "duck-pin",
      "do": [
        { "clue": "\"Got any grapes?\"\n\nThe duck found you first. One small treasure down — the drawer keeps more." },
        { "flag": "pin-found" }
      ]
    },

    {
      "id": "arm-hulk",
      "on": "combine", "a": "hulk-no-hammer", "b": "hulks-hammer",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "reveal": ["armed-hulk"] },
        { "remove": ["hulk-no-hammer", "hulks-hammer"] },
        { "flag": "hulk-armed" }
      ]
    },
    {
      "id": "smash-nugget",
      "on": "combine", "a": "armed-hulk", "b": "silver-nugget",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "reveal": ["rings"] },
        { "remove": ["armed-hulk", "silver-nugget"] },
        { "flag": "nugget-smashed" },
        { "flag": "ring-found" }
      ]
    },
    {
      "id": "torch-rings",
      "on": "combine", "a": "torch-lighter", "b": "rings",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "clue": "Held to the Ring, the metal whispers:\n\n  \"one PEZ dispenser to rule them all\"" },
        { "remove": ["torch-lighter"] },
        { "flag": "torch-clue-given" }
      ]
    },

    {
      "id": "pez-dispenses-receipt",
      "on": "click", "object": "pez",
      "once": true,
      "require": { "all": ["torch-clue-given"] },
      "do": [
        { "effect": "flash" },
        { "reveal": ["auction-receipt"] },
        { "clue": "*click*\n\nThe PEZ pops out a folded slip of paper." },
        { "flag": "receipt-dispensed" }
      ]
    },
    {
      "id": "pez-stale-joke",
      "on": "click", "object": "pez",
      "require": { "none": ["torch-clue-given"] },
      "do": [
        { "clue": "*click*\n\nA PEZ candy pops out. It's stale.\n(For now, anyway.)" }
      ]
    },
    {
      "id": "pez-empty",
      "on": "click", "object": "pez",
      "do": [
        { "clue": "*click*\n\nEmpty. The good stuff is already out." }
      ]
    },

    {
      "id": "read-receipt",
      "on": "click", "object": "auction-receipt",
      "do": [
        { "clue": "AUCTION RECEIPT — SOTHEBY'S\n\nLot 7: Golden Faberge Egg D'Elegance\n\nHammer price: $264,000,000\n\n(So that's a thing.)" }
      ]
    },

    {
      "id": "pump-duck-1",
      "on": "combine", "a": "mini-pump", "b": "duck-small",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "reveal": ["duck-mid"] },
        { "remove": ["duck-small"] },
        { "flag": "duck-stage-1" }
      ]
    },
    {
      "id": "pump-duck-2",
      "on": "combine", "a": "mini-pump", "b": "duck-mid",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "reveal": ["duck-giant"] },
        { "remove": ["mini-pump", "duck-mid"] },
        { "flag": "duck-stage-2" }
      ]
    },
    {
      "id": "duck-crush-browser",
      "on": "click", "object": "duck-giant",
      "do": [
        { "fullscreen": "duck-giant" },
        { "flag": "duck-crushed" }
      ]
    },

    {
      "id": "pineapple-duck-joke",
      "on": "click", "object": "duck-pineapple",
      "do": [
        { "clue": "It's a pineapple.\n\nOr a duck.\n\nYou decide." }
      ]
    }

  ]
}
