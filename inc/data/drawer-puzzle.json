      ]
    },
    {
      "id": "open-glasses-case",
      "on": "click", "object": "glasses-case",
      "once": true,
      "do": [
        { "clue": "You unsnap the case.\n\nInside: a pair of eyeglasses. Lenses look clean." },
        { "reveal": ["eyeglasses"] },
        { "remove": ["glasses-case"] },
        { "flag": "case-opened" }
      ]
    },
    {
      "id": "doodle-notebook-hint",
      "on": "click", "object": "doodle-notebook",
      "do": [
        { "clue": "*FUGGLERS NOTEBOOK*\n\nA scrawled doodle of a Fuggler creature\nwith sunglasses clipped over its glasses.\n\nBeneath, in pencil:\n  \"two pairs > one pair (sometimes)\"" }
      ]
    },
    {
      "id": "make-sunglasses",
      "on": "combine", "a": "eyeglasses", "b": "clip-ons",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "reveal": ["sunglasses"] },
        { "remove": ["eyeglasses", "clip-ons"] },
        { "flag": "sunglasses-made" }
      ]
    },
    {
      "id": "wear-sunglasses",
      "on": "click", "object": "sunglasses",
      "do": [
        { "clue": "You put the sunglasses on. The drawer takes\non a tinted hue.\n\nOn the bottom of the drawer, written in\nchildish hand where it was invisible before,\nyou can just make out:\n\n  \"See you again Dec. 1st 2026!!!\n   I can't wait to see what mischief\n   I get into now!!\"\n\n  — Jake" },
        { "flag": "elf-prelude-seen" }
      ]
    },

    {
      "id": "open-train-cover",
      "on": "combine", "a": "car-keys", "b": "toy-train",
      "once": true,
      "do": [
        { "clue": "The little screwdriver on the keychain fits\nthe battery cover. The screws back out cleanly." },
        { "flag": "battery-cover-open" }
      ]
    },
    {
      "id": "install-batteries",
      "on": "combine", "a": "aaa-batteries", "b": "toy-train",
      "once": true,
      "require": { "all": ["battery-cover-open"] },
      "do": [
        { "effect": "flash" },
        { "clue": "Two AAA snap into place. The train hums to life." },
        { "remove": ["aaa-batteries"] },
        { "flag": "train-ready" }
      ]
    },
    {
      "id": "batteries-no-cover",
      "on": "combine", "a": "aaa-batteries", "b": "toy-train",
      "require": { "none": ["battery-cover-open"] },
      "do": [
        { "clue": "The battery cover is screwed shut. Need to\nget that open first." }
      ]
    },
    {
      "id": "train-chugs",
      "on": "click", "object": "toy-train",
      "require": { "all": ["train-ready"] },
      "do": [
        { "clue": "*chugga chugga chugga*\n\nThe little train rumbles across the desk,\ndoes a tight loop, and stops where it started." },
        { "flag": "train-chugged" }
      ]
    },
    {
      "id": "train-silent",
      "on": "click", "object": "toy-train",
      "require": { "none": ["train-ready"] },
      "do": [
        { "clue": "The train sits silent. No spark." }
      ]
    },

    {
      "id": "iphone-videos",
      "on": "click", "object": "iphone",
      "do": [
        { "clue": "The screen wakes. Muted family videos play —\nsilly faces, kids cracking up, gone in seconds.\n\n(You can't hear them, but you remember anyway.)" }
      ]
    },

    {
      "id": "play-hangman",
      "on": "combine", "a": "sticky-notes", "b": "mech-pencil",
      "do": [
        { "effect": "flash" },
        { "hangman": true }
      ]
    }

  ]
}
