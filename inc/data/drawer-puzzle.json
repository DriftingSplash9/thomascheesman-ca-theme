  "interactions": [

    {
      "id": "todo-list",
      "on": "click", "object": "todo-notebook",
      "do": [
        { "clue": "TO DO\n  · Find Ring\n  · Tidy drawer\n  · Dust\n\n— notes to self —\n  · banana → eat it, or save it?\n  · drink the Ensure\n  · 67676767 ←" }
      ]
    },

    {
      "id": "tighten-screw",
      "on": "combine", "a": "screwdriver", "b": "screw",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "surface": "junk-dusty" },
        { "reveal": ["dust-spot"] },
        { "remove": ["screw", "screwdriver"] },
        { "flag": "screw-tight" }
      ]
    },
    {
      "id": "clear-dust",
      "on": "drop", "object": "green-duster", "zone": "dust-spot",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "surface": "junk-clean" },
        { "remove": ["green-duster"] },
        { "hide": ["dust-spot"] },
        { "reveal": ["duck-pin"] },
        { "flag": "dust-cleared" }
      ]
    },
    {
      "id": "duck-pin-clue",
      "on": "click", "object": "duck-pin",
      "do": [
        { "clue": "\"Got any grapes?\"\n\nThe duck found you first. One small treasure down — the drawer keeps more." },
        { "flag": "pin-found" }
      ]
    },

    {
      "id": "arm-hulk",
      "on": "combine", "a": "hulk-no-hammer", "b": "hulks-hammer",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "reveal": ["armed-hulk"] },
        { "remove": ["hulk-no-hammer", "hulks-hammer"] },
        { "flag": "hulk-armed" }
      ]
    },
    {
      "id": "smash-nugget",
      "on": "combine", "a": "armed-hulk", "b": "silver-nugget",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "reveal": ["rings"] },
        { "remove": ["armed-hulk", "silver-nugget"] },
        { "flag": "nugget-smashed" },
        { "flag": "ring-found" }
      ]
    },
    {
      "id": "torch-rings",
      "on": "combine", "a": "torch-lighter", "b": "rings",
      "once": true,
      "do": [
        { "effect": "flash" },
        { "clue": "Held to the Ring, the metal whispers:\n\n  \"one PEZ dispenser to rule them all\"" },
        { "remove": ["torch-lighter"] },
        { "flag": "torch-clue-given" }
      ]
    },

    {
      "id": "pez-dispenses-receipt",
      "on": "click", "object": "pez",
      "once": true,
      "require": { "all": ["torch-clue-given"] },
      "do": [
        { "effect": "flash" },
        { "reveal": ["auction-receipt"] },
        { "clue": "*click*\n\nThe PEZ pops out a folded slip of paper." },
        { "flag": "receipt-dispensed" }
      ]
    },
    {
      "id": "pez-stale-joke",
      "on": "click", "object": "pez",
      "require": { "none": ["torch-clue-given"] },
      "do": [
        { "clue": "*click*\n\nA PEZ candy pops out. It's stale.\n(For now, anyway.)" }
      ]
    },
    {
      "id": "pez-empty",
      "on": "click", "object": "pez",
      "do": [
        { "clue": "*click*\n\nEmpty. The good stuff is already out." }
      ]
    },

    {
      "id": "read-receipt",
      "on": "click", "object": "auction-receipt",
